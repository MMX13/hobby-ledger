{
  "name": "hobby-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A ledger of your hobbies - enjoyment, effort and time cost - installable as an offline PWA.",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev && npx --yes serve dist",
    "preview": "npx --yes serve dist",
    "test": "tsx --test src/engine/*.test.ts",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
